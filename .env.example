# Everything in this file is OPTIONAL for local use.
# On first run, MoneyTree asks you to create a username and password in the
# browser, and it generates and stores its own JWT secret in the data folder.
#
# Set these only for deployments that want env-managed credentials (e.g. a
# NAS behind a reverse proxy). Env credentials act as a fallback login and
# disable the first-run setup screen.

#AUTH_USERNAME=admin
# Generate with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
#AUTH_PASSWORD_HASH=
# Generate with: openssl rand -hex 32 (leave unset to let MoneyTree manage one)
#JWT_SECRET=
# Passkey (WebAuthn) domain binding; only needed behind a proxy/custom domain.
#RP_ID=localhost
#RP_ORIGIN=http://localhost:8000
